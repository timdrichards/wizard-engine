// Tests for the undo extension (src/ext/undo). Built only with build.sh --ext=undo.
// They run on every test tier of the target: on x86-64-linux, the fast interpreter and
// the jit, dyn and lazy strategies, where functions using undo stay in the interpreter
// and other functions are compiled.
def X_ = registerTests();
def registerTests() {
	TestTiers.addTests([
	("undo_depth0", test_depth0),
	("undo_depth_nested", test_depth_nested),
	("undo_depth_after_commit", test_depth_after_commit),
	("undo_rollback_store", test_rollback_store),
	("undo_commit_store", test_commit_store),
	("undo_nested_inner_rollback", test_nested_inner_rollback),
	("undo_nested_commit_outer_rollback", test_nested_commit_outer_rollback),
	("undo_unaligned_mixed", test_unaligned_mixed),
	("undo_fill_rollback", test_fill_rollback),
	("undo_fill_commit", test_fill_commit),
	("undo_copy_rollback", test_copy_rollback),
	("undo_commit_none", test_commit_none),
	("undo_rollback_none", test_rollback_none),
	("undo_rollback_callee_store", test_rollback_callee_store),
	("undo_commit_callee_store", test_commit_callee_store),
	("undo_rollback_two_pages", test_rollback_two_pages)
	]);
}
def Y_ = UnitTests.registerT("undo:", "needs_memory", CodeValidatorTester.new, test_needs_memory);

def BEGIN: Array<byte> = [0xF9, 0x00];
def COMMIT: Array<byte> = [0xF9, 0x01];
def ROLLBACK: Array<byte> = [0xF9, 0x02];
def DEPTH: Array<byte> = [0xF9, 0x03];
def ORIG: Array<byte> = [1, 2, 3, 4, 5, 6, 7, 8];

def op(o: Opcode) -> byte { return u8.!(o.code); }
def i32const(v: byte) -> Array<byte> { return [op(Opcode.I32_CONST), v]; } // v < 64
def store32(addr: byte, v: byte) -> Array<byte> { return seq([i32const(addr), i32const(v), [op(Opcode.I32_STORE), byte.!(2), byte.!(0)]]); }
def store8(addr: byte, v: byte) -> Array<byte> { return seq([i32const(addr), i32const(v), [op(Opcode.I32_STORE8), byte.!(0), byte.!(0)]]); }
// i64.store of -1 at the address on the stack
def STORE64_M1: Array<byte> = [u8.!(Opcode.I64_CONST.code), 0x7F, u8.!(Opcode.I64_STORE.code), 0, 0];
def MEMORY_FILL: Array<byte> = [0xFC, u8.!(Opcode.MEMORY_FILL.code), 0];
def MEMORY_COPY: Array<byte> = [0xFC, u8.!(Opcode.MEMORY_COPY.code), 0, 0];
def seq(parts: Array<Array<byte>>) -> Array<byte> {
	var r = Array<byte>.new(0);
	for (p in parts) r = Arrays.concat(r, p);
	return r;
}
// A module with one page of memory holding ORIG at offset 16.
def setup(i: ExeTester, sig: SigDecl) -> ExeTester {
	i.addMemory(1, Max.Set(1));
	i.addData(16, ORIG);
	i.sig(sig);
	return i;
}

def test_depth0(i: ExeTester) {
	setup(i, SigCache.v_i).codev(DEPTH);
	i.noargs().assert2_i(0);
}
def test_depth_nested(i: ExeTester) {
	setup(i, SigCache.v_i).codev(seq([BEGIN, BEGIN, DEPTH]));
	i.noargs().assert2_i(2);
}
def test_depth_after_commit(i: ExeTester) {
	setup(i, SigCache.v_i).codev(seq([BEGIN, COMMIT, DEPTH]));
	i.noargs().assert2_i(0);
}
def test_rollback_store(i: ExeTester) {
	setup(i, SigCache.v_v).codev(seq([BEGIN, store32(16, 42), ROLLBACK]));
	i.noargs().assert2_mem(16, ORIG);
}
def test_commit_store(i: ExeTester) {
	setup(i, SigCache.v_v).codev(seq([BEGIN, store32(16, 42), COMMIT]));
	i.noargs().assert2_mem(16, [42, 0, 0, 0, 5, 6, 7, 8]);
}
def test_nested_inner_rollback(i: ExeTester) {
	setup(i, SigCache.v_v).codev(seq([BEGIN, store8(16, 42), BEGIN, store8(17, 43), ROLLBACK, COMMIT]));
	i.noargs().assert2_mem(16, [42, 2, 3, 4, 5, 6, 7, 8]);
}
def test_nested_commit_outer_rollback(i: ExeTester) {
	setup(i, SigCache.v_v).codev(seq([BEGIN, BEGIN, store8(16, 42), COMMIT, ROLLBACK]));
	i.noargs().assert2_mem(16, ORIG);
}
def test_unaligned_mixed(i: ExeTester) {
	// An unaligned 8-byte store, then a 1-byte store inside it; rollback restores all 8 bytes.
	setup(i, SigCache.v_v).codev(seq([BEGIN,
		i32const(17), STORE64_M1,
		store8(18, 42),
		ROLLBACK]));
	i.noargs().assert2_mem(16, ORIG);
}
def test_fill_rollback(i: ExeTester) {
	setup(i, SigCache.v_v).codev(seq([BEGIN,
		i32const(16), i32const(0), i32const(8), MEMORY_FILL,
		ROLLBACK]));
	i.noargs().assert2_mem(16, ORIG);
}
def test_fill_commit(i: ExeTester) {
	setup(i, SigCache.v_v).codev(seq([BEGIN,
		i32const(16), i32const(0), i32const(8), MEMORY_FILL,
		COMMIT]));
	i.noargs().assert2_mem(16, [0, 0, 0, 0, 0, 0, 0, 0]);
}
def test_copy_rollback(i: ExeTester) {
	setup(i, SigCache.v_v).codev(seq([BEGIN,
		i32const(16), i32const(20), i32const(4), MEMORY_COPY,
		ROLLBACK]));
	i.noargs().assert2_mem(16, ORIG);
}
def test_commit_none(i: ExeTester) {
	setup(i, SigCache.v_v).codev(COMMIT);
	i.noargs().assert2_trap(TrapReason.ERROR);
}
def test_rollback_none(i: ExeTester) {
	setup(i, SigCache.v_v).codev(ROLLBACK);
	i.noargs().assert2_trap(TrapReason.ERROR);
}
// The validate hook rejects undo instructions in a module without a memory.
def test_needs_memory(t: CodeValidatorTester) {
	t.sig(SigCache.v_v);
	t.invalid(WasmError.OOB_INDEX, BEGIN, 1);
}
// A store made by another function, which the jit strategies compile while the
// function using undo stays in the interpreter: page protection must catch it.
def test_rollback_callee_store(i: ExeTester) {
	setup(i, SigCache.v_v);
	var f = i.newFunction(SigCache.v_v, store32(16, 42));
	i.codev(seq([BEGIN, [u8.!(Opcode.CALL.code), byte.!(f.func_index)], ROLLBACK]));
	i.noargs().assert2_mem(16, ORIG);
}
def test_commit_callee_store(i: ExeTester) {
	setup(i, SigCache.v_v);
	var f = i.newFunction(SigCache.v_v, store32(16, 42));
	i.codev(seq([BEGIN, [u8.!(Opcode.CALL.code), byte.!(f.func_index)], COMMIT]));
	i.noargs().assert2_mem(16, [42, 0, 0, 0, 5, 6, 7, 8]);
}
// Stores on two different OS pages (offsets 16 and 4100), rolled back together.
def test_rollback_two_pages(i: ExeTester) {
	setup(i, SigCache.v_v);
	var far: Array<byte> = [u8.!(Opcode.I32_CONST.code), 0x84, 0x20, u8.!(Opcode.I32_CONST.code), 42, u8.!(Opcode.I32_STORE.code), 2, 0];
	var f = i.newFunction(SigCache.v_v, seq([store32(16, 42), far]));
	i.codev(seq([BEGIN, [u8.!(Opcode.CALL.code), byte.!(f.func_index)], ROLLBACK]));
	i.noargs().assert2_mem(16, ORIG).assert2_mem(4100, [0, 0, 0, 0]);
}
