// How an extension opcode gets its encoding.
enum OpcodeClaim {
	FIXED,		// exactly its prefix and code, e.g. an encoding set by a binary format
	FLOATING	// any free one-byte slot; internal to the engine, never in input modules
}

// One instruction contributed by an {InstrExtension}. In the opcode tables it appears
// as {Opcode.EXT}, and {Opcodes.findExt} returns this descriptor. An extension defines
// each instruction as a subclass that overrides the hooks it needs, so an instruction's
// encoding, validation and semantics sit together. See ideas/Extensions.md.
class ExtOpcode(prefix: u8, code: u16, mnemonic: string, imms: Array<ImmKind>, sig: SigDecl, claim: OpcodeClaim) {
	var owner: InstrExtension;	// set when the opcode is placed
	var placed_prefix: u8;		// the final encoding; for FLOATING it differs from {prefix, code}
	var placed_code: u16;

	// Validation beyond the signature, which the validator checks first unless {sig} is
	// null (then this hook pops and pushes with {v.popE} and {v.push}). Immediates are read
	// with {v.parser}, which is positioned just after the opcode; errors are reported with
	// {v.err_atpc()}. Return false to reject the code.
	def validate(v: CodeValidator) -> bool {
		return true;
	}
	// The reference semantics: read immediates from {f.imm}, pop arguments from {f}, push
	// results, and return {TrapReason.NONE}, or the reason to trap.
	def interpret(f: ExtFrame) -> TrapReason {
		return TrapReason.UNIMPLEMENTED;
	}
	// Present this instruction to a bytecode visitor. Override to give particular
	// visitors more than {visitExt}.
	def accept(v: BytecodeVisitor) {
		v.visitExt(this);
	}

	// Block-shaped instructions. If true, the first immediate is a block type and the
	// validator opens a block, closed by an ordinary {end}, as for {block}.
	def opensBlock() -> bool {
		return false;
	}
	// Called when the validator reaches the {end} at {pos} that closes a block this
	// instruction opened. It may replace that byte with a one-byte extension opcode
	// ({v.rewriteOpcode}) to run code at the end of the block.
	def onEnd(v: CodeValidator, pos: int) { }
	// True for a one-byte instruction that replaces an {end} (see {onEnd}). The validator
	// treats it as {end} when it validates the code again.
	def endsBlock() -> bool {
		return false;
	}
	// Called for {br}, {br_if}, {br_table} and {return} that leave a block this
	// instruction opened. Report an error and return false to forbid it.
	def onBranchOut(v: CodeValidator) -> bool {
		return true;
	}
}
