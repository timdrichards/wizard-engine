// Base class for an instruction set extension. An extension lives in src/ext/<name>/
// and is compiled with {build.sh --ext=<name>}. See ideas/Extensions.md.
// Each hook receives one of this extension's own opcodes and matches over them.
class InstrExtension(name: string, help: string) {
	// The instructions this extension contributes. Called once, when opcodes are placed.
	def opcodes() -> Array<ExtOpcode> {
		return Array<ExtOpcode>.new(0);
	}
	// Extra validation for {op}, after the validator has checked its signature.
	// Report an error through {v.err_atpc()} and return false to reject the code.
	def validate(v: CodeValidator, op: ExtOpcode) -> bool {
		return true;
	}
	// The reference semantics of {op}: pop its arguments from {f}, push its results,
	// and return {TrapReason.NONE}, or return the reason to trap.
	def interpret(op: ExtOpcode, f: ExtFrame) -> TrapReason {
		return TrapReason.UNIMPLEMENTED;
	}
	// Present {op} to a bytecode visitor. Override to give particular visitors more.
	def accept(op: ExtOpcode, v: BytecodeVisitor) {
		v.visitExt(op);
	}
}

// The running frame, as an extension's {interpret} hook sees it. Each execution tier
// provides one.
class ExtFrame {
	def instance() -> Instance;
	def pop() -> Value;
	def push(v: Value);
	def popi() -> i32 { return Values.unbox_i(pop()); }
	def pushi(v: i32) { push(Value.I32(u32.view(v))); }
}
