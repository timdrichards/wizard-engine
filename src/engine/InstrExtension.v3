// An instruction set extension: a name, and the instructions it contributes. It lives in
// src/ext/<name>/ and is compiled with {build.sh --ext=<name>}. Each instruction is an
// {ExtOpcode} subclass carrying its own hooks. See ideas/Extensions.md.
class InstrExtension(name: string, help: string) {
	// The instructions this extension contributes. Called once, when opcodes are placed.
	def opcodes() -> Array<ExtOpcode> {
		return Array<ExtOpcode>.new(0);
	}
}

// The running frame, as an instruction's {interpret} hook sees it. Each execution tier
// provides one.
class ExtFrame {
	def imm = CodePtr.new(null);	// the instruction's immediates, positioned at the first
	def instance() -> Instance;
	def pop(t: ValueType) -> Value;
	def push(v: Value);
	def popi() -> i32 { return Values.unbox_i(pop(ValueType.I32)); }
	def pushi(v: i32) { push(Value.I32(u32.view(v))); }
}
