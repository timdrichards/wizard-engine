// A proof-of-concept extension that demonstrates the extension system: undo checkpoints
// for memory 0, a small in-memory version of a transaction.
//
//   undo.begin    (0xFA 0x00)  [] -> []     open a checkpoint
//   undo.commit   (0xFA 0x01)  [] -> []     keep the writes since the innermost checkpoint, close it
//   undo.rollback (0xFA 0x02)  [] -> []     restore every byte written since the innermost
//                                           checkpoint, close it
//   undo.depth    (0xFA 0x03)  [] -> [i32]  the number of open checkpoints
//
// Committing a nested checkpoint folds its writes into the enclosing one, so a later
// rollback of the outer checkpoint undoes them too. commit and rollback with no open
// checkpoint trap. Writes are seen through Memory's write observer: per write in the v3
// interpreter, and per page on native memories, where compiled code and the fast
// interpreter store directly and page protection catches the first write to each page.
class UndoExtension extends InstrExtension {
	def BEGIN	= ExtOpcode.new(0xFA, 0x00, "undo.begin", ImmSigs.NONE, SigCache.v_v, OpcodeClaim.FIXED);
	def COMMIT	= ExtOpcode.new(0xFA, 0x01, "undo.commit", ImmSigs.NONE, SigCache.v_v, OpcodeClaim.FIXED);
	def ROLLBACK	= ExtOpcode.new(0xFA, 0x02, "undo.rollback", ImmSigs.NONE, SigCache.v_v, OpcodeClaim.FIXED);
	def DEPTH	= ExtOpcode.new(0xFA, 0x03, "undo.depth", ImmSigs.NONE, SigCache.v_i, OpcodeClaim.FIXED);

	new() super("undo", "undo checkpoints for memory 0 (proof of concept)") { }

	def opcodes() -> Array<ExtOpcode> {
		return [BEGIN, COMMIT, ROLLBACK, DEPTH];
	}
	// Every undo instruction acts on memory 0, so the module must have one.
	def validate(v: CodeValidator, op: ExtOpcode) -> bool {
		if (v.module.memories.length == 0) {
			v.err_atpc().OobIndex("memory", 0, 0);
			return false;
		}
		return true;
	}
	def interpret(op: ExtOpcode, f: ExtFrame) -> TrapReason {
		var log = UndoLogs.of(f.instance());
		if (op == BEGIN) return log.begin();
		if (op == COMMIT) return log.commit();
		if (op == ROLLBACK) return log.rollback();
		if (op == DEPTH) {
			f.pushi(log.depth());
			return TrapReason.NONE;
		}
		return TrapReason.INVALID_OPCODE;
	}
}

// The undo log of one instance: before-images of memory 0 since the outermost open
// checkpoint, and where each open checkpoint starts in that log. The memory reports
// before-images either per write (the v3 interpreter) or per page (native memories,
// which track writes from compiled code by page protection).
class UndoLog(memory: Memory) extends InstanceExtState {
	def marks = Vector<int>.new();			// log position where each open checkpoint starts
	def positions = Vector<u64>.new();		// memory offset of each before-image
	def images = Vector<Array<byte>>.new();	// the bytes before the write
	var observer: UndoObserver;			// created on first use

	def begin() -> TrapReason {
		if (observer == null) observer = UndoObserver.new(this);
		if (marks.length == 0) memory.setWriteObserver(observer);
		else memory.restartWriteTracking(); // the next write to any page belongs to this checkpoint
		marks.put(positions.length);
		return TrapReason.NONE;
	}
	def commit() -> TrapReason {
		if (marks.length == 0) return TrapReason.ERROR; // no open checkpoint
		memory.flushWriteTracking();
		marks.resize(marks.length - 1);
		if (marks.length == 0) clear();
		return TrapReason.NONE;
	}
	def rollback() -> TrapReason {
		if (marks.length == 0) return TrapReason.ERROR; // no open checkpoint
		// Stop tracking first: it reports pending images, and restoring must not be tracked.
		memory.setWriteObserver(null);
		var start = marks[marks.length - 1];
		marks.resize(marks.length - 1);
		// Restore newest first, so the oldest before-image of each byte wins.
		for (i = positions.length - 1; i >= start; i--) {
			var image = images[i];
			var r = memory.range_ol_64(positions[i], u64.!(image.length));
			if (r.ok()) for (j < image.length) r.result[j] = image[j];
		}
		positions.resize(start);
		images.resize(start);
		if (marks.length > 0) memory.setWriteObserver(observer);
		else clear();
		return TrapReason.NONE;
	}
	def depth() -> int {
		return marks.length;
	}
	// Save the bytes [pos ..+ size] before they are written.
	def record(pos: u64, size: u64) {
		var r = memory.range_ol_64(pos, size);
		if (r.ok()) save(pos, r.result);
	}
	def save(pos: u64, image: Range<byte>) {
		positions.put(pos);
		images.put(Ranges.dup(image));
	}
	private def clear() {
		positions.resize(0);
		images.resize(0);
		memory.setWriteObserver(null);
	}
}

// Records before-images of memory 0 while a checkpoint is open.
class UndoObserver(log: UndoLog) extends MemoryWriteObserver {
	def beforeWrite(memory: Memory, pos: u64, size: u64) {
		log.record(pos, size);
	}
	def savedImage(memory: Memory, pos: u64, image: Range<byte>) {
		log.save(pos, image);
	}
}

component UndoLogs {
	// Find the undo log of {instance}, creating it on first use.
	def of(instance: Instance) -> UndoLog {
		for (s = instance.ext_state; s != null; s = s.next) {
			if (UndoLog.?(s)) return UndoLog.!(s);
		}
		var log = UndoLog.new(instance.memories[0]);
		log.next = instance.ext_state;
		instance.ext_state = log;
		return log;
	}
}
